<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Top Section with Logo and Language Toggle -->
    <LinearLayout
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/iffco_green"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <!-- Language Switcher positioned at the top right area -->
        <Button
            android:id="@+id/btnSwitchLang"
            android:text="हिन्दी"
            android:textSize="12sp"
            android:textColor="@color/iffco_green"
            android:backgroundTint="@color/iffco_white"
            android:layout_gravity="end"
            android:layout_margin="16dp"
            android:minWidth="80dp"
            android:layout_width="wrap_content"
            android:layout_height="36dp" />

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/farmer"
            android:scaleType="fitCenter"
            android:contentDescription="App Logo" />

        <TextView
            android:id="@+id/signupHeaderTitle"
            android:layout_marginTop="12dp"
            android:text="Create an Account"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Form Section -->
    <LinearLayout
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center"
        android:background="#FFFFFF"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <EditText
            android:id="@+id/signupName"
            android:hint="Full Name"
            android:drawablePadding="10dp"
            android:drawableStart="@android:drawable/ic_menu_edit"
            android:backgroundTint="@color/iffco_green"
            android:textColor="@color/black"
            android:layout_marginBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/signupEmail"
            android:hint="Email"
            android:drawablePadding="10dp"
            android:drawableStart="@android:drawable/ic_dialog_email"
            android:backgroundTint="@color/iffco_green"
            android:textColor="@color/black"
            android:layout_marginBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/signupPassword"
            android:hint="Password"
            android:inputType="textPassword"
            android:drawablePadding="10dp"
            android:drawableStart="@android:drawable/ic_lock_idle_lock"
            android:backgroundTint="@color/iffco_green"
            android:textColor="@color/black"
            android:layout_marginBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/signupBtn"
            android:text="Sign Up"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/iffco_blue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/gotoLogin"
            android:layout_marginTop="20dp"
            android:text="Already have an account? Login"
            android:textColor="@color/iffco_blue"
            android:textSize="14sp"
            android:padding="8dp"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>